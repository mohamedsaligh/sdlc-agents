# ============================================================================
# sdlc-agents : one-time platform configuration
# ----------------------------------------------------------------------------
# Every file in this repository refers to your environment ONLY through the
# tokens below. Fill in the right-hand side once, then run:
#
#   Windows :  powershell -ExecutionPolicy Bypass -File scripts\init-project.ps1
#   Mac/Linux: bash scripts/init-project.sh
#
# The script replaces every token in every text file (including this one)
# and writes config/.initialized. Do NOT edit tokens by hand elsewhere.
#
# Rules for values
#   - PLATFORM_NAME / DEVCTL / AI_PLATFORM : short names, no spaces preferred
#   - CODE_ROOT        : absolute path of the ONE parent folder that holds every
#                        service repository as a direct sub-folder
#                        (e.g. D:\work\platform  ->  D:\work\platform\service-a, ...)
#   - DESIGN_DOCS_ROOT : absolute path of the folder holding the reviewed
#                        design markdown files, one per service, named
#                        <service>.md  (kept OUTSIDE this repo and OUTSIDE CODE_ROOT)
# ============================================================================

PLATFORM_NAME=__PLATFORM_NAME__
DEVCTL=__DEVCTL__
AI_PLATFORM=__AI_PLATFORM__
CODE_ROOT=__CODE_ROOT__
DESIGN_DOCS_ROOT=__DESIGN_DOCS_ROOT__
